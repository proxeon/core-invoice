plans/

# Official artefacts (CEN EUPL-1.2, Peppol, OASIS, UNECE).
# README + fetch.sh stay tracked; clones, zips, and unpacked trees do not.
# `task spec` / `refers/fetch.sh` populate this. Never `git add` the bulky files.
/spec/
/refers/*
!/refers/README.md
!/refers/fetch.sh
